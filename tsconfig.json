{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    // The desktop server runs these .ts files directly with Node, which only strips types:
    // imports must name the .ts file, and syntax that needs compiling (enums, etc.) is out.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "test", "*.ts"]
}
