    "@fastify/static": "^10.1.6",
    "amazon-cognito-identity-js": "^6.3.22",
    "fastify": "^5.12.7",
    "fetch-cookie": "^3.2.0",
    "lit-html": "^3.3.3",
    "papaparse": "^5.7.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
