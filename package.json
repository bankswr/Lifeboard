{
  "name": "lifeboard",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch src/desktop/server.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop": "npm run build && node src/desktop/server.ts",
    "android": "npm run build && cap sync android",
    "apk": "bash scripts/build-apk.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fastify/static": "^10.1.6",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "amazon-cognito-identity-js": "^6.3.22",
    "capacitor-widget-bridge": "^8.1.0",
    "fastify": "^5.12.7",
    "fetch-cookie": "^3.2.0",
    "lit-html": "^3.3.3",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "tough-cookie": "^6.0.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
