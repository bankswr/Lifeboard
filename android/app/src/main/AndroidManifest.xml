<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <!-- Cleartext (http://) is for LAN sync with the desktop server, which has no HTTPS.
             Android can't limit cleartext to private addresses; outside services use https://. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Home-screen widget taps: lifeboard://open/<page> (src/app/widgets.ts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifeboard" android:host="open" />
            </intent-filter>

        </activity>

        <!-- Home-screen widgets: they only draw the app's snapshot (src/core/widgets.ts). -->
        <receiver
            android:name=".widgets.HealthWidget"
            android:label="@string/widget_health_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_health_info" />
        </receiver>
        <receiver
            android:name=".widgets.CalendarWidget"
            android:label="@string/widget_calendar_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendar_info" />
        </receiver>
        <receiver
            android:name=".widgets.AlertsWidget"
            android:label="@string/widget_alerts_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_alerts_info" />
        </receiver>
        <receiver
            android:name=".widgets.PetsWidget"
            android:label="@string/widget_pets_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pets_info" />
        </receiver>
        <receiver
            android:name=".widgets.ListsWidget"
            android:label="@string/widget_lists_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_lists_info" />
        </receiver>
        <activity
            android:name=".widgets.ListsWidgetConfigure"
            android:label="Choose a list"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Widget pop-up and tap handler: their own task (empty affinity), so the app isn't
             brought forward; only started by the widgets' own PendingIntents. -->
        <activity
            android:name=".widgets.ListAddActivity"
            android:label="Add an item"
            android:theme="@style/WidgetDialog"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:windowSoftInputMode="stateAlwaysVisible"
            android:exported="false" />
        <activity
            android:name=".widgets.CalendarTapActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
