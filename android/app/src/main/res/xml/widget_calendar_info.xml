<?xml version="1.0" encoding="utf-8"?>
<!-- Lifeboard's calendar widget (widgets/CalendarWidget.java). Never updates on a timer:
     the app redraws it whenever it runs (no background polling, docs/PLAN.md). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_calendar_description"
    android:initialLayout="@layout/widget_rows"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
